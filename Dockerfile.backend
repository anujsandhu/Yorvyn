# YORVYN Production-Grade Backend & Worker Container
# Multi-stage security-hardened container running unprivileged

FROM python:3.9-slim-bullseye AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install system dependencies for imaging and math libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && \
    pip install -r requirements.txt && \
    pip install redis asyncpg

# Copy application source code
COPY backend /app/backend
COPY models /app/models
COPY docs/reports/YORVYN_PHASE_13_MODEL_REGISTRY.json \
     docs/reports/YORVYN_PHASE_14_0_MODEL_PROVENANCE.json \
     docs/reports/YORVYN_PHASE_14_1_MODEL_PROVENANCE.json /app/docs/reports/

# Create non-root system user
RUN useradd -m -u 1001 yorvynuser && \
    chown -R yorvynuser:yorvynuser /app

USER yorvynuser

EXPOSE 8000 8088

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/ops/health || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
