# YORVYN Environment Variables Example
# Copy to .env and replace placeholder values before running docker compose or backend services.

ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=yorvyn_persistence
POSTGRES_USER=yorvyn
POSTGRES_PASSWORD=change-me-local-dev-password
DATABASE_URL=postgresql://yorvyn:change-me-local-dev-password@localhost:5432/yorvyn_persistence

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application & Worker Secrets (generate strong random values for any non-local environment)
YORVYN_SECURITY_SECRET=change-me-generate-32-byte-hex-secret
GARMENT_AI_REMOTE_API_KEY=change-me-remote-worker-api-key
GARMENT_AI_REMOTE_SIGNING_SECRET=change-me-remote-worker-signing-secret
