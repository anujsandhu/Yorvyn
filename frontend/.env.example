# Development: Use relative /api so Vite proxy forwards to backend
VITE_API_URL=/api

# Production: Use your Render backend API URL (update after deployment)
# VITE_API_URL=https://yorvyn-backend.onrender.com/api

# ── Supabase Authentication & Client ──────────────────────────────────
# Supabase Project URL (Client-safe)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (Client-safe)
# NEVER put SUPABASE_SERVICE_ROLE_KEY or database passwords in frontend!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
