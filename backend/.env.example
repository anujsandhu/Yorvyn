# ── Yorvyn Backend — AI Provider Configuration ────────────────────────
#
# cp backend/.env.example backend/.env
# Then fill in your API keys.
#
# TOKEN CONSERVATION: AI is only called when local ML confidence < 0.24
# All searches run on the local 73K perfume dataset first.
#
# FREE TIER LIMITS:
#   Groq:       14,400 req/day  |  6,000 tokens/min  ← PRIMARY (fastest)
#   OpenRouter: 200 req/day     |  20 req/min         ← SECONDARY
#   Gemini:     1,500 req/day   |  15 req/min         ← TERTIARY
#   OpenAI:     paid only                             ← QUATERNARY
#   HuggingFace: ~30 req/hr                           ← LAST RESORT

# ── 1. Groq (PRIMARY — fastest, most generous free tier) ──────────────
# Get free key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant

# ── 2. OpenRouter (SECONDARY — free :free models) ─────────────────────
# Get free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── 3. Google Gemini (TERTIARY) ────────────────────────────────────────
# Get free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── 4. OpenAI (QUATERNARY — paid) ─────────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── 5. HuggingFace (LAST RESORT) ──────────────────────────────────────
# Get free token: https://huggingface.co/settings/tokens
HF_API_KEY=your-huggingface-token-here
HF_MODEL=HuggingFaceH4/zephyr-7b-beta

# ── Token conservation settings ────────────────────────────────────────
AI_MAX_RESPONSE_TOKENS=150
AI_CACHE_TTL=3600

# ── AI fallback behaviour ──────────────────────────────────────────────
AI_FALLBACK_ENABLED=true
AI_FALLBACK_CONFIDENCE_THRESHOLD=0.24
AI_FALLBACK_TIMEOUT=12

# ── App ────────────────────────────────────────────────────────────────
DEBUG=true
APP_NAME=Yorvyn API
ENVIRONMENT=development

# ── Supabase Backend & Database ────────────────────────────────────────
# Project URL from Supabase Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Anonymous public key
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key (Keep server-side only! Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# JWT Secret for token verification (Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ── Cloudinary Image Storage & CDN Delivery ────────────────────────────
# Credentials from Cloudinary Dashboard -> Product Environment Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
# API Secret (Server-side only! Never expose to browser)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_SECURE=true
